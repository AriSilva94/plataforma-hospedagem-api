DATABASE_URL=
POSTGRES_PASSWORD=

REDIS_URL=

NODE_ENV=development
PORT=3030
FRONTEND_URL=http://localhost:3000
# Domínio comum ao frontend e à API. Deixe vazio no localhost.
COOKIE_DOMAIN=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_DAYS=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@localhost

# Google Cloud OAuth 2.0 Web client. Registre exatamente esta URL em Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3030/auth/google/callback
# Homologação e produção exigem callback HTTPS exato e credenciais próprias no Dokploy.
