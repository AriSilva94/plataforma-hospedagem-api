generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  OWNER
  AFFILIATE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  email                  String                 @unique
  passwordHash           String?                @map("password_hash")
  status                 UserStatus             @default(ACTIVE)
  roles                  Role[]
  guestProfile           GuestProfile?
  ownerProfile           OwnerProfile?
  authSessions           AuthSession[]
  externalAuthIdentities ExternalAuthIdentity[]
  passwordResetTokens    PasswordResetToken[]
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  @@map("users")
}

model GuestProfile {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @unique @map("user_id") @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  genderIdentity GenderIdentity? @map("gender_identity")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("guest_profiles")
}

model OwnerProfile {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("owner_profiles")
}

model AuthSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @map("family_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at")
  absoluteExpiresAt   DateTime  @map("absolute_expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model ExternalAuthIdentity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("external_auth_identities")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

enum GenderIdentity {
  MAN
  WOMAN
  TRANS_WOMAN
  TRANS_MAN
}

enum PropertyType {
  HOUSE
  APARTMENT
  TOWNHOUSE
  STUDIO
  SHARED_HOUSE
  OTHER
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  UNAVAILABLE
}

enum SharedAreaType {
  LIVING_ROOM
  KITCHEN
  SHARED_BATHROOM
  LAUNDRY
  OUTDOOR_AREA
  GARAGE
  OTHER
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  INACTIVE
}

enum BathroomType {
  PRIVATE
  SHARED
}

enum MediaType {
  IMAGE
  VIDEO
}

model Property {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerProfileId  String               @map("owner_profile_id") @db.Uuid
  ownerProfile    OwnerProfile         @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  status          PropertyStatus       @default(DRAFT)
  type            PropertyType
  title           String
  description     String?
  houseRules      String?              @map("house_rules")
  generalInfo     String?              @map("general_info")
  features        String[]             @default([])
  postalCode      String?              @map("postal_code")
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?              @db.Char(2)
  referencePoints String[]             @default([]) @map("reference_points")
  sharedAreas     PropertySharedArea[]
  media           PropertyMedia[]
  rooms           Room[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([ownerProfileId])
  @@map("properties")
}

model PropertySharedArea {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String         @map("property_id") @db.Uuid
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        SharedAreaType
  label       String?
  description String?
  position    Int
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("property_shared_areas")
}

model PropertyMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  position   Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([propertyId, position])
  @@map("property_media")
}

model Room {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId        String           @map("property_id") @db.Uuid
  property          Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status            RoomStatus       @default(AVAILABLE)
  title             String
  description       String?
  priceCents        Int              @map("price_cents")
  capacity          Int
  bathroomType      BathroomType     @map("bathroom_type")
  acceptedAudiences GenderIdentity[] @map("accepted_audiences")
  amenities         String[]         @default([])
  additionalInfo    String?          @map("additional_info")
  completenessScore Int              @default(0) @map("completeness_score")
  rankingScore      Int              @default(0) @map("ranking_score")
  rankingVersion    Int              @default(0) @map("ranking_version")
  rankingUpdatedAt  DateTime?        @map("ranking_updated_at")
  featuredFrom      DateTime?        @map("featured_from")
  featuredUntil     DateTime?        @map("featured_until")
  media             RoomMedia[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([status, rankingScore(sort: Desc), id])
  @@index([featuredUntil])
  @@map("rooms")
}

model RoomMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  position   Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([roomId, position])
  @@map("room_media")
}
