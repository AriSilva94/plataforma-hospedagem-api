generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  OWNER
  AFFILIATE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  email                  String                  @unique
  passwordHash           String?                 @map("password_hash")
  status                 UserStatus              @default(ACTIVE)
  roles                  Role[]
  guestProfile           GuestProfile?
  ownerProfile           OwnerProfile?
  authSessions           AuthSession[]
  externalAuthIdentities ExternalAuthIdentity[]
  emailVerifiedAt        DateTime?               @map("email_verified_at")
  phone                  String?
  birthDate              DateTime?               @map("birth_date") @db.Date
  city                   String?
  state                  String?                 @db.Char(2)
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken?
  favorites              Favorite[]
  storyViews             RoomStoryView[]
  avatarKey              String?                 @map("avatar_key")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("users")
}

model GuestProfile {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @unique @map("user_id") @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  genderIdentity GenderIdentity? @map("gender_identity")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("guest_profiles")
}

model OwnerProfile {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("owner_profiles")
}

model AuthSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @map("family_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at")
  absoluteExpiresAt   DateTime  @map("absolute_expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model ExternalAuthIdentity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("external_auth_identities")
}

model PendingRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  name         String
  tokenHash    String?  @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("pending_registrations")
}

model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  email     String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

enum GenderIdentity {
  MAN
  WOMAN
  TRANS_WOMAN
  TRANS_MAN
}

enum PropertyType {
  HOUSE
  APARTMENT
  MOTEL
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  UNAVAILABLE
}

enum SharedAreaType {
  LIVING_ROOM
  KITCHEN
  SHARED_BATHROOM
  LAUNDRY
  OUTDOOR_AREA
  GARAGE
  OTHER
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  INACTIVE
}

enum RoomVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RoomStoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CleaningFrequency {
  DAILY
  SEVERAL_TIMES_WEEK
  WEEKLY
  BIWEEKLY
  MONTHLY
  ON_DEMAND
}

enum SmokingPolicy {
  NOT_ALLOWED
  OUTDOOR_ONLY
  ALLOWED
}

enum BathroomType {
  PRIVATE
  SHARED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  BUNK
  SOFA_BED
}

model Property {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerProfileId  String               @map("owner_profile_id") @db.Uuid
  ownerProfile    OwnerProfile         @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)
  status          PropertyStatus       @default(DRAFT)
  type            PropertyType
  title           String
  description     String?
  houseRules      String?              @map("house_rules")
  generalInfo     String?              @map("general_info")
  features        String[]             @default([])
  postalCode      String?              @map("postal_code")
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?              @db.Char(2)
  referencePoints String[]             @default([]) @map("reference_points")
  hasCleaner        Boolean?           @map("has_cleaner")
  cleaningFrequency CleaningFrequency? @map("cleaning_frequency")
  smokingPolicy     SmokingPolicy?     @map("smoking_policy")
  sharedAreas     PropertySharedArea[]
  media           PropertyMedia[]
  rooms           Room[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([ownerProfileId])
  @@map("properties")
}

model PropertySharedArea {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String         @map("property_id") @db.Uuid
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        SharedAreaType
  label       String?
  description String?
  position    Int
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("property_shared_areas")
}

model PropertyMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  position   Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([propertyId, position])
  @@map("property_media")
}

model Room {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId                 String                 @map("property_id") @db.Uuid
  property                   Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status                     RoomStatus             @default(AVAILABLE)
  title                      String
  description                String?
  priceCents                 Int                    @map("price_cents")
  capacity                   Int
  bathroomType               BathroomType           @map("bathroom_type")
  acceptedAudiences          GenderIdentity[]       @map("accepted_audiences")
  amenities                  String[]               @default([])
  blockedWeekdays            Int[]                  @default([]) @map("blocked_weekdays")
  additionalInfo             String?                @map("additional_info")
  hasCleaner                 Boolean?               @map("has_cleaner")
  cleaningFrequency          CleaningFrequency?     @map("cleaning_frequency")
  smokingPolicy              SmokingPolicy?         @map("smoking_policy")
  completenessScore          Int                    @default(0) @map("completeness_score")
  rankingScore               Int                    @default(0) @map("ranking_score")
  rankingVersion             Int                    @default(0) @map("ranking_version")
  rankingUpdatedAt           DateTime?              @map("ranking_updated_at")
  featuredFrom               DateTime?              @map("featured_from")
  featuredUntil              DateTime?              @map("featured_until")
  verificationStatus         RoomVerificationStatus @default(PENDING) @map("verification_status")
  verificationRejectedReason String?                @map("verification_rejected_reason")
  storyStatus                RoomStoryStatus        @default(PENDING) @map("story_status")
  storyRejectedReason        String?                @map("story_rejected_reason")
  storyApprovedAt            DateTime?              @map("story_approved_at")
  beds                       RoomBed[]
  media                      RoomMedia[]
  storyMedia                 RoomStoryMedia[]
  storyViews                 RoomStoryView[]
  favorites                  Favorite[]
  blockedDates               RoomBlockedDate[]
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([status, rankingScore(sort: Desc), id])
  @@index([featuredUntil])
  @@map("rooms")
}

model RoomBed {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId   String  @map("room_id") @db.Uuid
  room     Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type     BedType
  quantity Int

  @@unique([roomId, type])
  @@index([roomId])
  @@map("room_beds")
}

model RoomStoryMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  position   Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([roomId, position])
  @@map("room_story_media")
}

model RoomBlockedDate {
  roomId String   @map("room_id") @db.Uuid
  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@id([roomId, date])
  @@map("room_blocked_dates")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String   @map("room_id") @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roomId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([roomId])
  @@map("favorites")
}

model RoomMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type       MediaType
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  position   Int
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([roomId, position])
  @@map("room_media")
}

model RoomStoryView {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyApprovedAt DateTime @map("story_approved_at")
  viewCount       Int      @default(1) @map("view_count")
  firstViewedAt   DateTime @default(now()) @map("first_viewed_at")
  lastViewedAt    DateTime @default(now()) @map("last_viewed_at")

  @@unique([roomId, userId, storyApprovedAt])
  @@index([userId])
  @@map("room_story_views")
}
